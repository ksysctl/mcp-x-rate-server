{
  "name": "dgt-x-rate-mcp",
  "version": "1.1.1",
  "description": "An MCP server for official Costa Rican USD to CRC exchange rates",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ksysctl/mcp-x-rate-server.git"
  },
  "homepage": "https://github.com/ksysctl/mcp-x-rate-server#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "exchange-rate",
    "costa-rica",
    "usd",
    "crc"
  ],
  "type": "module",
  "files": [
    "build/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
